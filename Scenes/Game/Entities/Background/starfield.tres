[gd_resource type="Shader" format=2]

[resource]
code = "shader_type canvas_item;

uniform vec2 camera_pos;
uniform float zoom = 1.0;

uniform float brightness = 0.35;
uniform float softness = 0.6;

float rand(vec2 p){
    return fract(sin(dot(p ,vec2(12.9898,78.233))) * 43758.5453);
}

vec3 star_color(float seed){

    if(seed < 0.25){
        return vec3(1.0,0.85,0.6); // yellow
    }
    else if(seed < 0.5){
        return vec3(0.9,0.9,1.0); // white
    }
    else if(seed < 0.75){
        return vec3(0.7,0.8,1.0); // blue
    }

    return vec3(1.0,0.7,0.7); // red
}

vec4 star_layer(vec2 uv, float scale, float density, float depth_dim){

    vec2 pos = uv * scale + camera_pos * scale * 0.02;

    vec2 grid = floor(pos);
    vec2 local = fract(pos) - 0.5;

    float spawn = rand(grid);

    if(spawn < 1.0 - density){
        return vec4(0.0);
    }

    // second random for color
    float color_seed = rand(grid + 13.5);

    float dist = length(local);

    float falloff = smoothstep(softness, 0.0, dist);

    vec3 color = star_color(color_seed);

    return vec4(color * falloff * depth_dim, falloff);
}

void fragment(){

    vec2 uv = UV * (120.0 * (zoom * 0.5));

    vec4 stars = vec4(0.1);

    stars += star_layer(uv, 0.5, 0.002, 0.4);
    stars += star_layer(uv, 1.0, 0.003, 0.7);
    stars += star_layer(uv, 2.0, 0.004, 1.0);

    stars.rgb *= brightness;

    COLOR = vec4(stars.rgb,1.0);
}"
